GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
SHODH_API_URL=http://localhost:8000

# Free-tier model availability changes over time (Google retired
# gemini-2.0-flash in March 2026). Default is a "-latest" alias, not a
# pinned version — pinned versions get retired, and a model can still
# show up in `python scripts/list_models.py` after it's no longer
# callable ("no longer available to new users"). If Gemini calls start
# failing, run that script and prefer another -latest alias over a
# pinned version.
GEMINI_MODEL=gemini-flash-latest

# Critique passes only if zero claims are unsupported and at most this
# many are weakly-supported.
MAX_WEAK_CLAIMS=2
